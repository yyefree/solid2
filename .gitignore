# 依赖
node_modules/

# 构建产物
dist/
.vite/

# 桌面版打包产物（几百 MB，不入库）
release/
desktop/*.icon.tmp

# 巡演录像（独立目录：dist/ 会被 vite build 清空，视频放那儿会被误删）
videos/

# 临时 / 工具目录
.shots/
.workbuddy-ai/

# 测试运行器生成的构建缓存与 OCCT ESM 补丁
tools/.ktest/
tools/.ocjs.esm.mjs

# 巡演脚本轮换状态（每次运行都变，不入库）
tools/tour/.last-script.json

# 工具内部的应用标记文件（非项目产物）
*.genie

# 日志与系统文件
*.log
npm-debug.log*
.DS_Store
Thumbs.db
